generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum DriverVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(PASSENGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passengerProfile PassengerProfile?
  driverProfile    DriverProfile?
  ridesAsPassenger Ride[]             @relation("PassengerRides")
  sessions         AuthSession[]
  auditEvents      AdminAuditLog[]    @relation("AuditActor")

  @@index([role, createdAt])
}

model PassengerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DriverProfile {
  id               String                   @id @default(cuid())
  userId           String                   @unique
  verification     DriverVerificationStatus @default(PENDING)
  online           Boolean                  @default(false)
  latitude         Float?
  longitude        Float?
  locationUpdatedAt DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle?
  rides   Ride[]

  @@index([verification, online, latitude, longitude])
}

model Vehicle {
  id           String   @id @default(cuid())
  driverId     String   @unique
  type         String
  make         String?
  model        String?
  color        String?
  licensePlate String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model Ride {
  id                    String     @id @default(cuid())
  passengerId           String
  driverId              String?
  rideType              String
  pickupAddress         String
  pickupLatitude        Float
  pickupLongitude       Float
  destinationAddress    String
  destinationLatitude   Float
  destinationLongitude  Float
  distanceKm            Float
  estimatedDurationMins Int
  distanceSource        String
  estimatedFare         Decimal    @db.Decimal(10, 2)
  finalFare             Decimal?   @db.Decimal(10, 2)
  status                RideStatus @default(REQUESTED)
  cancellationReason    String?
  cancelledById         String?
  requestedAt           DateTime   @default(now())
  acceptedAt            DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  passenger User          @relation("PassengerRides", fields: [passengerId], references: [id], onDelete: Restrict)
  driver    DriverProfile? @relation(fields: [driverId], references: [id], onDelete: Restrict)
  payment   Payment?
  invoice   Invoice?

  @@index([passengerId, createdAt])
  @@index([driverId, status])
  @@index([status, requestedAt])
}

model Payment {
  id          String        @id @default(cuid())
  rideId      String        @unique
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("INR")
  status      PaymentStatus @default(PENDING)
  method      String?
  provider    String        @default("development")
  providerRef String?       @unique
  idempotencyKey String?    @unique
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model Invoice {
  id          String   @id @default(cuid())
  rideId      String   @unique
  invoiceNo   String   @unique
  currency    String   @default("INR")
  subtotal    Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  issuedAt    DateTime @default(now())
  snapshot    Json

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Restrict)
}

model AuthSession {
  id        String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

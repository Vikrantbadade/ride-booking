# Copy to .env for local development. Never commit actual secrets.
DATABASE_URL="postgresql://ridex:ridex_dev_password@127.0.0.1:5433/ridex?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
JWT_ACCESS_TTL="1h"
PORT=3001
NODE_ENV=development
# Optional comma-separated web origins. Native clients without an Origin are allowed.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"
# Optional pricing customization
FARE_CURRENCY="INR"
ROAD_DISTANCE_FACTOR=1.25
SEED_DEMO_PASSWORD="set-a-local-development-only-password"
